# ==============================================================================
# AURUM FINANCIAL INTELLIGENCE — VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings -> Environment Variables.
# NEVER commit actual secret values into source control.

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Mandatory. Secret string used for signing session JWT tokens.
# Generate a 64-character secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-production-jwt-secret-at-least-32-chars

# Optional: Google OAuth Client ID for "Sign in with Google" button.
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 2. PERSISTENT DATABASE (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Mandatory for production persistence. MongoDB Atlas cluster connection URI.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Database name inside MongoDB cluster. Defaults to 'portfolio_intelligence'.
MONGODB_DB_NAME=portfolio_intelligence

# ------------------------------------------------------------------------------
# 3. AI INTELLIGENCE ENGINE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Recommended. Enables Gemini multi-factor AI reasoning for Ask Aurum & Stock Reports.
# Create key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. MARKET DATA & SECURITY MASTER PROVIDERS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Recommended for US real-time quote data & earnings calendar.
# Register at https://finnhub.io/
FINNHUB_API_KEY=

# Recommended for US & Global market fallback quotes.
# Register at https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Recommended for Indian Market (NSE/BSE) institutional real-time quotes & order gateway.
# Register at https://upstox.com/developer/api/
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=

# Optional: Alpha Vantage market intelligence API key.
# Register at https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=

# ------------------------------------------------------------------------------
# 5. BROKERAGE INTEGRATION GATEWAYS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Optional: Zerodha Kite Connect credentials for Indian portfolio sync.
KITE_API_KEY=
KITE_API_SECRET=

# Optional: Webull app credentials for US portfolio sync.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Optional: VAPID keys for browser push alerts.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
