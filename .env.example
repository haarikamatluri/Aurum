# Copy this file to .env and fill in values for local development.
# In production (Railway, etc.) set these as real environment variables instead.

# Required. Signs session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: enables "Sign in with Google". Leave blank to disable it.
# Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application -> Authorized JavaScript origins:
#  http://localhost:4000 and http://localhost:4200, plus your prod domain
#  later). No client secret needed.
GOOGLE_CLIENT_ID=

# Optional: MongoDB Atlas connection string. Leave blank to use in-memory storage.
MONGODB_URI=

PORT=4000

# Optional: Web Push Notifications (VAPID)
# Generated automatically if left blank, or set fixed keys for persistent subscriptions:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: Server-level Zerodha Kite Connect credentials (India)
# If provided in Railway, users only need to supply their daily request_token or use sandbox.
KITE_API_KEY=
KITE_API_SECRET=

# Optional: Server-level Webull credentials (US)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
